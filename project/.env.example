# Copy this file to .env and fill in real values.
# .env itself should never be committed — it's expected to be in .gitignore.

# --- MinIO (object storage for page images) ---
# Defaults below match docker-compose-minio.yml; override if you point at a
# different MinIO instance (e.g., a shared/remote one).
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me

# --- Hugging Face Hub (required for gated models) ---
# services/llm_service.py loads meta-llama/Llama-2-7b-chat-hf, which is a
# gated model on Hugging Face. Request access at the model page, then set:
HUGGING_FACE_HUB_TOKEN=

# Note: QDRANT_HOST/QDRANT_PORT and the ColPali model name are currently
# hardcoded in config.py rather than read from the environment. If you need
# to point at a non-default Qdrant instance, edit config.py directly.
